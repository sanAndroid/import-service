"""Vivino scraper implementation."""

import re
from typing import Any, Dict, List
from urllib.parse import quote_plus

from .base import BaseScraper


class VivinoScraper(BaseScraper):
    """Scraper for Vivino.com."""

    def __init__(self):
        super().__init__("vivino", "https://www.vivino.com")

    async def search(self, query: str) -> List[Dict[str, Any]]:
        """Search for wines on Vivino."""
        search_url = f"{self.base_url}/search/wines?q={quote_plus(query)}"
        
        try:
            html = await self.fetch_with_playwright(search_url, ".wine-card")
            soup = self.parse_html(html)
            
            wines = []
            wine_cards = soup.select(".wine-card")
            
            for card in wine_cards[:5]:  # Limit to top 5 results
                wine_data = self._extract_wine_data(card)
                if wine_data:
                    wines.append(wine_data)
            
            return wines
            
        except Exception as e:
            self.logger.error(f"Error searching Vivino for '{query}': {e}")
            return []

    async def get_wine_details(self, wine_id: str) -> Dict[str, Any]:
        """Get detailed information about a specific wine."""
        wine_url = f"{self.base_url}/wines/{wine_id}"
        
        try:
            html = await self.fetch_with_playwright(wine_url, ".wine-info")
            soup = self.parse_html(html)
            
            return self._extract_detailed_data(soup)
            
        except Exception as e:
            self.logger.error(f"Error getting Vivino details for {wine_id}: {e}")
            return {}

    def _extract_wine_data(self, card) -> Dict[str, Any]:
        """Extract wine data from a wine card."""
        try:
            name_elem = card.select_one(".wine-card__name")
            name = name_elem.text.strip() if name_elem else "N/A"
            
            rating_elem = card.select_one(".average__number")
            rating = float(rating_elem.text.strip()) if rating_elem else None
            
            ratings_count_elem = card.select_one(".text-micro")
            ratings_count = self._extract_number(ratings_count_elem.text) if ratings_count_elem else 0
            
            winery_elem = card.select_one(".wine-card__winery")
            winery = winery_elem.text.strip() if winery_elem else "N/A"
            
            image_elem = card.select_one(".wine-card__image img")
            image_url = image_elem.get("src", "") if image_elem else ""
            
            wine_link_elem = card.select_one("a.wine-card__link")
            wine_url = wine_link_elem.get("href", "") if wine_link_elem else ""
            wine_id = wine_url.split("/")[-1] if wine_url else ""
            
            return {
                "name": name,
                "winery": winery,
                "rating": rating,
                "ratings_count": ratings_count,
                "image_url": image_url,
                "wine_id": wine_id,
                "url": f"{self.base_url}{wine_url}",
                "source": "vivino",
            }
            
        except Exception as e:
            self.logger.warning(f"Error extracting wine data from card: {e}")
            return None

    def _extract_detailed_data(self, soup) -> Dict[str, Any]:
        """Extract detailed wine information."""
        try:
            wine_info = {}
            
            # Basic info
            wine_info["name"] = self._get_text(soup, "h1.wine-title")
            wine_info["winery"] = self._get_text(soup, ".winery-name")
            wine_info["region"] = self._get_text(soup, ".region-name")
            wine_info["country"] = self._get_text(soup, ".country-name")
            
            # Ratings
            wine_info["rating"] = self._get_float(soup, ".average__number")
            wine_info["ratings_count"] = self._get_number(soup, ".ratings-count")
            
            # Wine details
            wine_info["alcohol_content"] = self._get_text(soup, ".alcohol-content")
            wine_info["grapes"] = self._get_text(soup, ".grapes")
            wine_info["style"] = self._get_text(soup, ".wine-style")
            
            # Price range
            price_elem = soup.select_one(".price-range")
            wine_info["price_range"] = price_elem.text.strip() if price_elem else "N/A"
            
            return wine_info
            
        except Exception as e:
            self.logger.error(f"Error extracting detailed data: {e}")
            return {}

    def _get_text(self, soup, selector: str) -> str:
        """Get text content from a selector."""
        elem = soup.select_one(selector)
        return elem.text.strip() if elem else "N/A"

    def _get_float(self, soup, selector: str) -> float:
        """Get float value from a selector."""
        text = self._get_text(soup, selector)
        try:
            return float(text) if text != "N/A" else 0.0
        except ValueError:
            return 0.0

    def _get_number(self, soup, selector: str) -> int:
        """Get integer value from a selector."""
        text = self._get_text(soup, selector)
        return self._extract_number(text)

    def _extract_number(self, text: str) -> int:
        """Extract number from text."""
        if not text:
            return 0
        
        numbers = re.findall(r'\d+', text.replace(",", ""))
        return int(numbers[0]) if numbers else 0