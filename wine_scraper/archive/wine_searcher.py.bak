"""Wine-Searcher scraper implementation."""

import re
from typing import Any, Dict, List
from urllib.parse import quote_plus

from .base import BaseScraper


class WineSearcherScraper(BaseScraper):
    """Scraper for Wine-Searcher.com."""

    def __init__(self):
        super().__init__("wine_searcher", "https://www.wine-searcher.com")

    async def search(self, query: str) -> List[Dict[str, Any]]:
        """Search for wines on Wine-Searcher."""
        search_url = f"{self.base_url}/find/{quote_plus(query)}"
        
        try:
            html = await self.fetch_with_playwright(search_url, ".prod-profile_rcs")
            soup = self.parse_html(html)
            
            wine_data = self._extract_wine_data(soup)
            return [wine_data] if wine_data else []
            
        except Exception as e:
            self.logger.error(f"Error searching Wine-Searcher for '{query}': {e}")
            return []

    async def get_wine_details(self, wine_id: str) -> Dict[str, Any]:
        """Get detailed information about a specific wine."""
        wine_url = f"{self.base_url}/find/{wine_id}"
        
        try:
            html = await self.fetch_with_playwright(wine_url, ".prod-profile_rcs")
            soup = self.parse_html(html)
            
            return self._extract_wine_data(soup)
            
        except Exception as e:
            self.logger.error(f"Error getting Wine-Searcher details for {wine_id}: {e}")
            return {}

    def _extract_wine_data(self, soup) -> Dict[str, Any]:
        """Extract wine data from Wine-Searcher page."""
        try:
            wine_data = {}
            
            # Wine name
            name_elem = soup.select_one("h1.h2.mb-0")
            wine_data["name"] = name_elem.text.strip() if name_elem else "N/A"
            
            # User ratings
            user_rating_elem = soup.select_one("#ratingInfo span.ml-1.font-light-bold")
            wine_data["avg_user"] = self._extract_float(user_rating_elem.text) if user_rating_elem else "N/A"
            
            user_count_elem = soup.select_one("#ratingInfo span.mt-1 span.font-light-bold")
            wine_data["user_count"] = self._extract_number(user_count_elem.text) if user_count_elem else "N/A"
            
            # Critic ratings
            critic_rating_elem = soup.select_one("#criticsInfo .badge-rating span:first-child")
            wine_data["avg_critics"] = self._extract_float(critic_rating_elem.text) if critic_rating_elem else "N/A"
            
            critic_count_elem = soup.select_one("#criticsInfo .mt-1 span.font-light-bold")
            wine_data["critics_count"] = self._extract_number(critic_count_elem.text) if critic_count_elem else "N/A"
            
            # Region and producer info
            breadcrumb_elem = soup.select_one(".breadcrumb")
            if breadcrumb_elem:
                wine_data["region"] = self._extract_region(breadcrumb_elem.text)
                wine_data["producer"] = self._extract_producer(breadcrumb_elem.text)
            
            # Price range
            price_elem = soup.select_one(".price-range")
            wine_data["price_range"] = price_elem.text.strip() if price_elem else "N/A"
            
            wine_data["source"] = "wine_searcher"
            return wine_data
            
        except Exception as e:
            self.logger.warning(f"Error extracting wine data: {e}")
            return None

    def _extract_float(self, text: str) -> float:
        """Extract float value from text."""
        if not text:
            return 0.0
        
        match = re.search(r'[\d.]+', text)
        return float(match.group()) if match else 0.0

    def _extract_number(self, text: str) -> int:
        """Extract integer value from text."""
        if not text:
            return 0
        
        match = re.search(r'[\d,]+', text)
        return int(match.group().replace(',', '')) if match else 0

    def _extract_region(self, breadcrumb_text: str) -> str:
        """Extract region from breadcrumb text."""
        parts = breadcrumb_text.split(' / ')
        for part in parts:
            if any(keyword in part.lower() for keyword in ['region', 'appellation', 'aoc']):
                return part.strip()
        return "N/A"

    def _extract_producer(self, breadcrumb_text: str) -> str:
        """Extract producer from breadcrumb text."""
        parts = breadcrumb_text.split(' / ')
        for part in parts:
            if any(keyword in part.lower() for keyword in ['producer', 'winery', 'château', 'domaine']):
                return part.strip()
        return "N/A"